POSTGRES_USER=invoice
POSTGRES_PASSWORD=put-your-password-here
POSTGRES_DB=invoice_db
DATABASE_URL=postgresql+psycopg://invoice:put-your-password-here@127.0.0.1:5432/invoice_db

# production hides /docs and /openapi.json, logs JSON and refuses to run the seed.
# ENVIRONMENT=development
# LOG_LEVEL=INFO

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-one-with-python-secrets-token_hex-32
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Without a key the API runs but extraction answers 503.
ANTHROPIC_API_KEY=put-your-anthropic-api-key-here
# LLM_MODEL=claude-haiku-5-5
# LLM_TIMEOUT_SECONDS=30.0
# LLM_MAX_RETRIES=2
# LLM_MAX_OUTPUT_TOKENS=1024
# Per process: with several workers the total is this times the workers.
# LLM_MAX_CONCURRENT_CALLS=20
# MAX_INVOICE_TEXT_CHARS=20000
# Update both prices by hand whenever LLM_MODEL changes.
# LLM_INPUT_PRICE_PER_MTOK=0.10
# LLM_OUTPUT_PRICE_PER_MTOK=0.50

# Daily spending caps in USD per UTC day (see tests/test_config.py for the ratio).
# USER_DAILY_BUDGET_USD=0.05
# GLOBAL_DAILY_BUDGET_USD=5.00

# Abuse limits per client IP.
# LOGIN_MAX_FAILURES_PER_IP_AND_EMAIL=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_WINDOW_MINUTES=15
# REGISTER_MAX_PER_IP=5
# REGISTER_WINDOW_MINUTES=60
